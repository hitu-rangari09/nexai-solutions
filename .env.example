# =============================================================================
# .env.example — key NAMES only. Never put real values in this file.
# Copy to .env and fill in there. .env is gitignored and must stay that way.
# =============================================================================
#
# SCOPE, ON PURPOSE:
#   This file holds AI, search, and TTS keys ONLY.
#
#   There is deliberately NO YouTube upload credential, NO OAuth publishing
#   token, NO channel-management key, and NO payment/billing credential here.
#   Uploading and publishing are manual human steps. Money is never spent by
#   this system. Do not add keys of those kinds to this file — if you ever
#   need one, that is a conversation, not a config change.
#
# Fill in only the providers you actually use. Empty is fine; an agent that
# needs a missing key will say so instead of guessing.
# =============================================================================

# --- AI / text generation ----------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Search / research -------------------------------------------------------
# Used for topic and trend research. Pick whichever you have.
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=
# YouTube Data API v3 — READ-ONLY research use (search, public video metadata).
# This is not an upload credential and must not be used as one.
YOUTUBE_DATA_API_KEY=

# --- Text to speech ----------------------------------------------------------
ELEVENLABS_API_KEY=
PLAYHT_API_KEY=
PLAYHT_USER_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- AI image / visual generation (optional) ---------------------------------
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# --- Non-secret defaults -----------------------------------------------------
DEFAULT_TTS_VOICE_ID=
DEFAULT_TTS_MODEL=
OUTPUT_DIR=./output
